    "cmake.configureArgs": [
        "-G",
        "Ninja",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER_LAUNCHER=ccache",
        "-DDOWNLOAD_EXTRACT_TIMESTAMP=true"
    ],
    //"C_Cpp.intelliSenseEngine": "Tag Parser",
